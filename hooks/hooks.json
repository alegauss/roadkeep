{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "roadkeep guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "roadkeep guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
