# What the build downloads and what it caches.
node_modules
*.local

# What the two builds write. `dist/` is the whole published site — the pitch, and the
# documentation area under dist/docs — and `dist-server/` is the SSR bundle the prerender
# imports. Neither is committed: a generated tree in the repository is a second answer to what
# the site is, and the stale one the moment somebody edits a page and does not rebuild.
dist
dist-server
