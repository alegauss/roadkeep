__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# setuptools' own output, at the root only (RK1700): unanchored it also hid every new file
# under gui/build/, which is the desktop app's installer resources and is committed.
/build/
dist/
.roadkeep/
# The site's build output is ignored in site/.gitignore, beside the two builds that write it
# (RK1398). Nothing generated is committed: a copy in the tree is a second answer to what the
# site is, and the stale one the moment somebody edits a page and does not rebuild — the
# staleness the derived README block already has a gate against.
