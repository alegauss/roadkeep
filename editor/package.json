{
  "name": "roadkeep",
  "displayName": "roadkeep",
  "description": "The backlog this workspace governs, read by the command that owns it.",
  "version": "0.2.35",
  "publisher": "alegauss",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:roadkeep.toml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "roadkeep",
          "title": "roadkeep",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "roadkeep": [
        {
          "id": "roadkeep.backlog",
          "name": "Backlog"
        }
      ]
    },
    "commands": [
      {
        "command": "roadkeep.add",
        "title": "roadkeep: Add a task",
        "icon": "$(add)"
      },
      {
        "command": "roadkeep.refresh",
        "title": "roadkeep: Refresh the backlog",
        "icon": "$(refresh)"
      },
      {
        "command": "roadkeep.repair",
        "title": "roadkeep: Repair what the gate can close"
      },
      {
        "command": "roadkeep.run",
        "title": "roadkeep: Run a door the gate named"
      },
      {
        "command": "roadkeep.explain",
        "title": "roadkeep: Explain a gate code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "roadkeep.add",
          "when": "view == roadkeep.backlog",
          "group": "navigation"
        },
        {
          "command": "roadkeep.refresh",
          "when": "view == roadkeep.backlog",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "roadkeep.run",
          "when": "false"
        },
        {
          "command": "roadkeep.explain",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "roadkeep",
      "properties": {
        "roadkeep.command": {
          "type": "string",
          "default": "",
          "description": "The roadkeep this workspace writes with — required. The view refuses to answer rather than resolve one from PATH, a virtualenv or a cache, because a panel answering from a copy your commits do not use fails quietly."
        }
      }
    }
  }
}
