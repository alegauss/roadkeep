{
  "mcpServers": {
    "roadkeep": {
      "command": "python",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/roadkeep-launch.py", "mcp"]
    },
    "playwright": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/node_modules/@playwright/mcp/cli.js",
        "--cdp-endpoint",
        "http://127.0.0.1:9333"
      ]
    }
  }
}
