#!/bin/sh
# Bump the patch version on every commit (RK153).
#
# Claude Code re-reads an installed plugin when the manifest's version changes, so a checkout
# whose number only moves at release time is one the running session keeps loading the old
# copy of — a hook fixed an hour ago goes on denying the write it used to deny.
#
# Not a second writer of the number: this calls the same script the release workflow calls,
# which writes both places the version lives (`src/roadkeep/__init__.py` and
# `.claude-plugin/plugin.json`), and `tests/test_plugin.py` holds those two to one fact.
#
# It never blocks a commit. A missing interpreter costs a plugin refresh and a refused commit
# costs the session, so every path out of here is exit 0. `--no-verify` skips it entirely.
#
# It stages only what it wrote (RK320). `git add` takes a path and not a diff, so staging a
# file that already carried an unstaged edit puts that edit under this commit's message —
# measured once, with another agent's manifest change landing under an unrelated subject.
#
# "An edit this hook did not write" is a comparison and not a dirty flag (RK398). Read as a
# flag it re-armed itself for ever: the bump is written to the working tree unconditionally,
# which *is* an unstaged edit to both files, so the next commit saw one and refused again —
# measured over eight commits, the checkout reaching 0.1.392 while HEAD said 0.1.388. So the
# question is asked of the version string alone, against the index, by the one thing that
# knows how to read it: `--for-commit` derives the number from the committed one and exits 3
# where either file differs by anything wider. The bump still happens there, because RK153's
# argument is about the checkout the session loads and not about the commit.
#
# Wired per clone, because a hook in `.git/hooks` is not something a clone carries:
#     git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

versioned="src/roadkeep/__init__.py .claude-plugin/plugin.json"

for interpreter in python python3 py; do
	if command -v "$interpreter" >/dev/null 2>&1; then
		"$interpreter" "$root/scripts/bump_version.py" --level patch --for-commit
		case $? in
			0)
				# Deliberately unquoted: the list above is two paths, not one.
				git -C "$root" add -- $versioned || true
				;;
			3)
				echo "pre-commit: a version file carries an edit this hook did not write; version bumped in the working tree, staged nothing" >&2
				;;
			*)
				echo "pre-commit: bump_version.py failed, version not bumped" >&2
				;;
		esac
		exit 0
	fi
done

echo "pre-commit: no python on PATH, version not bumped" >&2
exit 0
